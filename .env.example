#
# Copy this file to .env and set a real API key before running Reed.
#   cp .env.example .env

# Required. Any long, random string — Reed doesn't validate its shape,
# just that it matches on every request. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
REED_API_KEY=

# Optional. Path to the Kuzu database file inside the container.
# The default matches the volume mount in docker-compose.yml.
REED_DATA_PATH=/data/reed.kuzu

# Optional. Default poll interval in minutes for feeds that don't set
# their own poll_interval_minutes.
REED_POLL_DEFAULT_INTERVAL=60
